# Copia este archivo a .env si necesitas fijar a qué backend habla la app.
# Todo lo que empieza por EXPO_PUBLIC_ queda DENTRO de la app compilada y
# cualquiera puede leerlo: aquí no va ningún secreto.

# Vacío = en desarrollo, la IP desde la que el teléfono bajó el código (puerto
# 3000); en un build de producción, https://bitemo.co/api. Hace falta definirla
# con un túnel de Expo o para apuntar a otro servidor, por ejemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
EXPO_PUBLIC_API_URL=
