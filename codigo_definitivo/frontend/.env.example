# Copia este archivo a .env y ajusta los valores. Vite expone al navegador
# TODO lo que empiece por VITE_, así que aquí no va ningún secreto.

# Backend. En producción el Dockerfile lo fija en /api (Nginx enruta).
VITE_API_URL=http://localhost:3000/api

# Dominio público del sitio. Es el único lugar donde vive: de aquí salen el
# canonical, las etiquetas para compartir en redes, robots.txt y sitemap.xml.
# Debe ir SIN barra final y con https:// en producción.
VITE_SITIO_URL=https://bitemo.com

# Mesa del restaurante de prueba a la que apunta "Ver el menú de ejemplo".
# Solo hace falta si el demo se monta con un token distinto al del seed.
VITE_DEMO_MESA_TOKEN=bitemo-demo

# Video que se reproduce dentro del teléfono del hero (vertical 9:16, sin audio,
# en bucle). Mientras esté vacío, el teléfono muestra la maqueta dibujada en CSS:
# la landing no se rompe por no tenerlo.
VITE_VIDEO_DEMO_URL=
VITE_VIDEO_DEMO_POSTER=
