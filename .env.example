# === Configuración de producción para docker-compose ===
# Copia este archivo a ".env" (en esta misma carpeta) y rellena los valores.
# NUNCA subas el .env real a ningún repositorio ni lo compartas.

# --- Base de datos MySQL (corre en Docker) ---
DB_NAME=menu_digital_saas
DB_USER=bitemo
DB_PASSWORD=pon_una_contraseña_fuerte
DB_ROOT_PASSWORD=pon_otra_contraseña_fuerte_para_root

# --- Autenticación ---
JWT_SECRET=genera_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# --- Bunny Stream (videos) ---
# Se obtienen en dash.bunny.net → Stream → tu Video Library.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Wompi (cobro de la suscripción) ---
# Se obtienen en comercios.wompi.co → Desarrolladores. Las de prueba empiezan
# por pub_test_ y el backend habla solo con el sandbox; las de producción por
# pub_prod_. Si falta cualquiera de las tres, el botón de pagar queda
# desactivado y el resto del panel funciona igual.
# El webhook se configura en ese mismo panel apuntando a:
#   https://bitemo.co/api/pagos/wompi/eventos
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Resend (correo: recuperar contraseña) ---
# La llave sale de resend.com → API Keys. Antes hay que verificar el dominio
# bitemo.co en Resend → Domains, añadiendo en Cloudflare los registros DNS que
# indica (sin eso, Resend rechaza el remitente no-responder@bitemo.co).
# Sin llave no se envía ningún correo: el formulario responde igual, pero el
# enlace no llega.
RESEND_API_KEY=
CORREO_REMITENTE=Antojate <no-responder@bitemo.co>
